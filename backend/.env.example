DASHSCOPE_API_KEY=your_api_key_here
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT=15
DETECT_TEMPERATURE=0.2

# 多粒度检测配置
ENABLE_MULTI_GRANULARITY=true
SENTENCE_ANALYSIS_THRESHOLD=0.6

# 反向检测配置（当判断为人类时也进行句子级验证）
ENABLE_REVERSE_CHECK=true

# Browser origins allowed to call the API (comma-separated). Use * only for local experiments.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Per-IP request cap for /api/* except /api/health
RATE_LIMIT_PER_MINUTE=60
